all:
  vars:
    ansible_user: vagrant

  children:
    # Gruppo globale per tutte le VM
    docker_nodes:
      hosts:
{% for vm in vagrant_vms %}
        {{ vm.name }}:
          ansible_host: {{ vm.ip }}
          ansible_ssh_private_key_file: "{{ playbook_dir }}/vagrant_env/.vagrant/machines/{{ vm.name }}/virtualbox/private_key"
          node_exporter_port: {{ 9100 + loop.index0 }}
{% endfor %}

    # Gruppi dinamici per le singole macchine
{% for vm in vagrant_vms %}
    {{ vm.name }}_group:
      hosts:
        {{ vm.name }}:
{% endfor %}